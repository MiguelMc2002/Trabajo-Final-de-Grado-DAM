{
  "metadata": [
    {
      "src": [
        {
          "files": ["TFG/Assets/Scripts/**/*.cs"],
          "exclude": ["**/obj/**", "**/bin/**", "**/Editor/**"]
        }
      ],
      "dest": "docs/api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "allowCompilationErrors": true
    }
  ],
  "build": {
    "template": ["default", "docs/templates/custom"],
    "content": [
      {
        "files": ["**.yml", "**.md"],
        "src": "docs/api",
        "dest": "api"
      },
      {
        "files": ["index.md", "toc.yml", "modulos/*.md", "modulos/toc.yml"],
        "src": "docs"
      }
    ],
    "dest": "docs/_site",
    "globalMetadata": {
      "_appTitle": "Mare Imperium — Documentación Técnica",
      "_appFooter": "Miguel Menéndez Caro · TFG 2º DAM · Colegios Marianistas",
      "_enableSearch": true
    }
  }
}
